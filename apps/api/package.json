{
  "name": "@pdfe/api",
  "version": "0.2.0",
  "private": true,
  "description": "PDFE modular-monolith API (NestJS). DEMO mode only.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:once": "node dist/main.js --once",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@pdfe/domain-types": "workspace:*",
    "@pdfe/platform-core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@pdfe/config": "workspace:*",
    "@pdfe/test-kit": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
