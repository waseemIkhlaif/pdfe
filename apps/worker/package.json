{
  "name": "@pdfe/worker",
  "version": "0.2.0",
  "private": true,
  "description": "PDFE background worker (NestJS standalone context): outbox relay, activation, anchoring, expiry.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test:unit": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@pdfe/domain-types": "workspace:*",
    "@pdfe/platform-core": "workspace:*",
    "bullmq": "^6.7.6",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@pdfe/config": "workspace:*",
    "@pdfe/test-kit": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
