{
  "name": "@pdfe/ui-web",
  "version": "0.2.0",
  "private": true,
  "description": "Shared React components for the web apps: simulation banner, shells, state components.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@pdfe/platform-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@pdfe/config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  }
}
