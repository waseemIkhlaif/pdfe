{
  "name": "@pdfe/platform-core",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic core shared by api, worker, mock-hub and scripts: clock, ids, random, correlation, canonical JSON, errors, egress guard, migrations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pdfe-migrate": "dist/migrate/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfe/domain-types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pure-rand": "^8.4.2"
  },
  "devDependencies": {
    "@pdfe/config": "workspace:*",
    "@pdfe/test-kit": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.5.438",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sim-label": {
      "types": "./dist/sim-label.d.ts",
      "default": "./dist/sim-label.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./sim-label-pdf": {
      "types": "./dist/sim-label-pdf.d.ts",
      "default": "./dist/sim-label-pdf.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./json-patch": {
      "types": "./dist/json-patch.d.ts",
      "default": "./dist/json-patch.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist"
  ]
}
