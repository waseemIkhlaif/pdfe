{
  "name": "@pdfe/platform-core",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic core shared by api, worker, mock-hub and scripts: clock, ids, random, correlation, canonical JSON, errors, egress guard, migrations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pdfe-migrate": "dist/migrate/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pure-rand": "^8.4.2",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@pdfe/config": "workspace:*",
    "@pdfe/test-kit": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sim-label": {
      "types": "./dist/sim-label.d.ts",
      "default": "./dist/sim-label.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
