{
  "elevation": {
    "$type": "shadow",
    "1": {
      "$value": "0 1px 2px rgba(15, 23, 42, 0.08)",
      "$extensions": {
        "pdfe": {
          "native": {
            "offsetY": 1,
            "blur": 2,
            "opacity": 0.08,
            "elevation": 1
          }
        }
      }
    },
    "2": {
      "$value": "0 4px 8px rgba(15, 23, 42, 0.12)",
      "$extensions": {
        "pdfe": {
          "native": {
            "offsetY": 4,
            "blur": 8,
            "opacity": 0.12,
            "elevation": 4
          }
        }
      }
    },
    "3": {
      "$value": "0 12px 24px rgba(15, 23, 42, 0.16)",
      "$extensions": {
        "pdfe": {
          "native": {
            "offsetY": 12,
            "blur": 24,
            "opacity": 0.16,
            "elevation": 12
          }
        }
      }
    }
  }
}
